{
  "buildCommand": "pnpm install && pnpm --filter @workspace/weather-app run build:vercel",
  "outputDirectory": "artifacts/weather-app/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
